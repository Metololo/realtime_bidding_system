# Auction engine HTTP port exposed by Docker Compose.
AUCTION_ENGINE_SELL_PORT=8080

# Auction engine gRPC port for bidder bid placement.
AUCTION_ENGINE_GRPC_PORT=9001

# NATS server used for auction.created and auction.closed events.
NATS_SERVER_URL=nats://nats-server:4222

# Seller-service target URL for the auction engine HTTP create-auction endpoint.
# Docker Compose uses the service name for container-to-container traffic.
# For local host runs outside Docker, override with http://localhost:8080.
AUCTION_ENGINE_URL=http://auction-engine:8080

# Delay between seller requests. Parsed with Go time.ParseDuration.
# Accepted units include ns, us/µs, ms, s, m, h.
# Examples: 10s = one request every 10 seconds, 1ms = 1000 req/s, 100us = 10000 req/s.
SELLER_INTERVAL=10s

# Bidder-service instances are configured with CONFIG_PATH in docker-compose.yaml:
# - /configs/bidders/conservative.yaml
# - /configs/bidders/balanced.yaml
# - /configs/bidders/aggressive.yaml
# Each YAML has a distinct bidder.id and strategy.
